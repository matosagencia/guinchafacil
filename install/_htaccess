Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order Deny,Allow
  Deny from all
</IfModule>

# Libera somente se você adicionar ?key=SEU_TOKEN
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} !(^|&)key=SEU_TOKEN_AQUI(&|$) [NC]
  RewriteRule ^ - [F]
</IfModule>