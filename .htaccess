# ============================================================
# GuinchaFÃ¡cil - .htaccess (XAMPP / Apache Local)
# ============================================================

DirectoryIndex index.php
Options -Indexes

AddDefaultCharset UTF-8
AddCharset UTF-8 .php .html .css .js
SetEnv TZ America/Sao_Paulo

# ------------------------------------------------------------
# Bloquear acesso a arquivos sensÃ­veis
# ------------------------------------------------------------
<IfModule mod_authz_core.c>
    <Files "config.php">
        Require all denied
    </Files>

    <FilesMatch "^(diagnostico|phpinfo|probe|_dbg)\.php$">
        Require all denied
    </FilesMatch>

    <FilesMatch "\.(sql|log|md|env|git|htaccess|htpasswd|ini|bak|old)$">
        Require all denied
    </FilesMatch>

    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# Rewrites
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # O app detecta o base path automaticamente no index.php.
    # Evite fixar RewriteBase para funcionar tanto em /guinchafacil quanto na raiz.
    RewriteRule ^sitemap\.xml$ index.php [QSA,L]
    RewriteRule ^sw\.js$ public/sw.js [L]

    # Bloquear acesso a diretÃ³rios de cÃ³digo/sensÃ­veis
    RewriteRule ^(src|install|logs|vendor|tmp|cache|doc|tests|qa|tools|database|files|storage)/ - [F,L]

    # Redirecionar tudo para index.php (exceto arquivos e diretÃ³rios existentes)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ------------------------------------------------------------
# Headers de seguranÃ§a e ConfiguraÃ§Ãµes
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

LimitRequestBody 5242880
ServerSignature Off

