# GuinchaFacil - override local for XAMPP
#
# This file is kept in the repository only for local development. The FTP
# deploy script does not publish it.

# XAMPP local: o VirtualHost de :8080 aponta diretamente para este projeto
# (C:/xampp/htdocs/guinchafacil). Portanto os assets ficam em /public/...
# e a aplicação roda na raiz do host, sem o prefixo /guinchafacil.
DB_HOST=localhost
DB_NAME=guinchafacil_dev
DB_USER=root
DB_PASS=
APP_URL=http://localhost:8080
APP_ENV=development
APP_DEBUG=true
HTTPS_ONLY=false
MP_ENV=sandbox
FORCE_BASEPATH=
PAYMENT_GATEWAY_ACTIVE=mercadopago
PUSH_VAPID_PUBLIC_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEEjKHnLEmS/HVCFpuUnd/ir+zR2btlxk3e8+JnXVZUzJHARq3aDBVDH6NkI0e6ZnFwYd28J5HeG3SN+EJJtZ9aA==
