# GuinchaFácil — template de variáveis de ambiente
# Copie para .env e preencha com os valores reais

# Banco de dados
DB_HOST=localhost
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASS=sua_senha

# Aplicação
APP_URL=https://seudominio.com.br
APP_ENV=production
ENCRYPTION_KEY=chave-aleatoria-minimo-32-chars
ADMIN_EMAIL=admin@seudominio.com.br

# MercadoPago (painel MP > Credenciais)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# PagSeguro
PS_TOKEN=
PS_EMAIL=
# PagSeguro environment: 'sandbox' or 'production'
PS_ENV=sandbox

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GuinchaFácil
