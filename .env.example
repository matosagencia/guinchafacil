# GuinchaFacil -- example environment
# Copy to .env.local for local/staging use. Do not commit real secrets.

DB_HOST=127.0.0.1
DB_NAME=guinchafacil
DB_USER=guinchafacil_user
DB_PASS=change-me

APP_NAME=GuinchaFacil
APP_URL=http://localhost/guinchafacil
APP_ENV=production
APP_DEBUG=false
HTTPS_ONLY=false
FORCE_BASEPATH=/guinchafacil

COMPANY_ADDRESS=Rua Exemplo, 123
COMPANY_WHATSAPP=5500000000000
ADMIN_EMAIL=admin@example.com

SERPAPI_KEY=
PROSPECCAO_URL_PRE_CADASTRO=https://example.com/parceiros/interesse
PROSPECCAO_OFERTA_RECIPROCIDADE=primeiros 30 dias sem taxa de adesao
PROSPECCAO_CATEGORIAS_ALVO=guincho,reboque,autoeletrica,borracheiro,chaveiro_automotivo,mecanico_movel,oficina_mecanica,bateria_automotiva,socorro_veicular
PROSPECCAO_QUOTA_ALVO_PADRAO=5
PROSPECCAO_PRIORIDADE_FUSEKI_PADRAO=100
PROSPECCAO_RAIO_PADRAO_KM=15

PAYMENT_GATEWAY_ACTIVE=mercadopago

MP_ENV=sandbox
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_ACCESS_TOKEN_SANDBOX=
MP_ACCESS_TOKEN_PROD=
MP_PUBLIC_KEY_SANDBOX=
MP_PUBLIC_KEY_PROD=
MP_CLIENT_ID_PROD=
MP_CLIENT_SECRET_PROD=

PS_EMAIL=
PS_TOKEN=
PS_ENV=sandbox

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GuinchaFacil

SIMULATION_ENABLED=false
PIX_DRY_RUN=true
SIMULATION_ADMIN_TOKEN=change-me

MAX_PIX_TENTATIVAS=10
GEOCODING_CACHE_TTL_DAYS=30
TARIFA_BASE=10
TARIFA_KM=3.75
ENCRYPTION_KEY=change-this-secret-key

# Kill switch do log do sistema (Logger::event -- logs/app-*.jsonl + app_logs).
# Deixe "true" em desenvolvimento. Em producao, o recomendado e "false" e
# ligar so durante janelas de manutencao periodica (editavel em /admin/env).
SYSTEM_LOG_ENABLED=false

ROUTE_PROVIDER=google
ROUTE_API_KEY=
INSTALL_KEY=change-me
